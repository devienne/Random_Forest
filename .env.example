# ── Project paths ────────────────────────────────────────────────────────────
# Root directory for all downloaded and processed data.
# Override this to point to a different drive or mount point.
DATA_DIR=data

# ── IRIS FDSN API ────────────────────────────────────────────────────────────
# Base URL for the IRIS FDSN station and dataselect web services.
# Only override if you are using a mirror or proxy.
IRIS_STATION_URL=http://service.iris.edu/fdsnws/station/1/query
IRIS_DATASELECT_URL=http://service.iris.edu/fdsnws/dataselect/1/query

# ── UNAVCO GPS API ───────────────────────────────────────────────────────────
# Base URL for UNAVCO GPS metadata and position services.
UNAVCO_METADATA_URL=https://web-services.unavco.org/gps/metadata/sites/v1
UNAVCO_POSITION_URL=https://web-services.unavco.org/gps/data/position

# ── MLflow (Phase 2) ─────────────────────────────────────────────────────────
# Local tracking URI. Change to a remote server URI when deploying.
MLFLOW_TRACKING_URI=artifacts/mlruns

# ── Database (Phase 2) ───────────────────────────────────────────────────────
# SQLite database file path. Replace with a PostgreSQL URI for production.
DATABASE_URL=sqlite:///artifacts/cascadia.db
